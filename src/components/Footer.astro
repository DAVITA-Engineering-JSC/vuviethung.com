---
import { SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="wrap">
    <div class="foot-row">
      <span>&copy; {year} {SITE_TITLE}</span>
      <div class="foot-links">
        <a href="/blog">Bài viết</a>
        <a href="/about">Giới thiệu</a>
        <a href="/rss.xml">RSS</a>
      </div>
    </div>
    <p class="theme-note"><span id="themeNote"></span> <button type="button" id="themeAuto" hidden>Trở về mặc định</button></p>
  </div>
</footer>

<!-- Nut doi giao dien, dong ghi chu o chan trang va loi chao theo gio. -->
<script is:inline>
(function () {
  var btn = document.getElementById('themeBtn');
  var lbl = document.getElementById('themeLbl');
  var note = document.getElementById('themeNote');
  var autoBtn = document.getElementById('themeAuto');
  var greeting = document.getElementById('greeting');
  if (!window.vvhTheme || !btn) return;

  function pad(n) { return (n < 10 ? '0' : '') + n; }

  function render(state) {
    var now = new Date();
    var h = now.getHours();
    var isDark = state.theme === 'dark';
    if (lbl) lbl.textContent = isDark ? 'Tối' : 'Sáng';
    btn.setAttribute('aria-label', isDark ? 'Đang ở giao diện tối. Bấm để chuyển sang sáng' : 'Đang ở giao diện sáng. Bấm để chuyển sang tối');
    btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    var clock = pad(h) + ':' + pad(now.getMinutes());
    if (note) note.textContent = state.manual
      ? 'Giao diện ' + (isDark ? 'tối' : 'sáng') + ', do bạn chọn.'
      : 'Giao diện sáng, mặc định của trang.';
    if (autoBtn) autoBtn.hidden = !state.manual;
    if (greeting) greeting.textContent = h >= 5 && h < 11 ? 'Chào buổi sáng'
      : h >= 11 && h < 13 ? 'Chào buổi trưa'
      : h >= 13 && h < 18 ? 'Chào buổi chiều' : 'Chào buổi tối';
  }

  btn.addEventListener('click', function () {
    var cur = document.documentElement.getAttribute('data-theme');
    render(window.vvhTheme.set(cur === 'dark' ? 'light' : 'dark'));
  });
  if (autoBtn) autoBtn.addEventListener('click', function () { render(window.vvhTheme.clear()); });

  render(window.vvhTheme.apply());
  // Kiem lai moi 30 giay de trang tu doi mau khi nguoi xem dang doc qua moc 06:00 hoac 18:00.
  setInterval(function () { render(window.vvhTheme.apply()); }, 30000);
  document.addEventListener('visibilitychange', function () { if (!document.hidden) render(window.vvhTheme.apply()); });
})();
</script>
