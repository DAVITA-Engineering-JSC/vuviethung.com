---
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const inBlog = path.startsWith('/blog');
const inTopic = path.startsWith('/chu-de');
const inAbout = path.startsWith('/about');
---

<a class="skip" href="#noi-dung">Bỏ qua, tới nội dung chính</a>
<header class="site-head">
  <div class="wrap head-row">
    <a class="brand" href="/" aria-label={SITE_TITLE + ', về trang chủ'}>
      <span class="brand-mark" aria-hidden="true">VH</span>
      <span class="brand-name">{SITE_TITLE}</span>
    </a>
    <nav class="nav" aria-label="Điều hướng chính">
      <a href="/blog" class:list={[{ active: inBlog }]} aria-current={inBlog ? 'page' : undefined}>Bài viết</a>
      <a href="/#chu-de" class:list={[{ active: inTopic }]}>Chủ đề</a>
      <a href="/about" class:list={['hide-s', { active: inAbout }]} aria-current={inAbout ? 'page' : undefined}>Giới thiệu</a>
    </nav>
    <button class="theme-btn" id="themeBtn" type="button" aria-label="Đổi giao diện sáng hoặc tối">
      <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor" stroke="none"></circle><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3 7 7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7"></path></svg>
      <svg class="ico-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"></path></svg>
      <span class="lbl" id="themeLbl">Sáng</span>
      <span class="auto-dot" title="Đang tự động theo giờ của bạn" aria-hidden="true"></span>
    </button>
  </div>
</header>
