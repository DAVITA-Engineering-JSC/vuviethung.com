---
// global.css duoc nap o day de moi trang dung chung mot bo giao dien.
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = '/blog-placeholder-1.jpg' } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />

<!-- Chon giao dien sang hoac toi truoc khi ve trang, de khong bi nhay mau.
     Mac dinh: sang, vao bat ky gio nao.
     Nguoi xem bam nut doi sang toi thi lua chon duoc giu tren may ho. -->
<script is:inline>
(function () {
  var KEY = 'vvh-theme';
  var DAY_START = 6, DAY_END = 18;
  // Mac dinh luon la giao dien sang. Giao dien toi chi bat khi nguoi xem tu bam nut.
  function autoTheme(d) { return 'light'; }
  function nextBoundary(d) {
    var n = new Date(d.getTime()); n.setMinutes(0, 0, 0);
    var h = d.getHours();
    if (h < DAY_START) n.setHours(DAY_START);
    else if (h < DAY_END) n.setHours(DAY_END);
    else { n.setDate(n.getDate() + 1); n.setHours(DAY_START); }
    return n.getTime();
  }
  function read() {
    try {
      var o = JSON.parse(localStorage.getItem(KEY));
      if (o && o.until > Date.now() && (o.theme === 'light' || o.theme === 'dark')) return o;
    } catch (e) {}
    return null;
  }
  function apply() {
    var o = read();
    var theme = o ? o.theme : autoTheme(new Date());
    var el = document.documentElement;
    el.setAttribute('data-theme', theme);
    el.setAttribute('data-mode', o ? 'manual' : 'auto');
    return { theme: theme, manual: !!o };
  }
  window.vvhTheme = {
    apply: apply,
    set: function (theme) {
      try { localStorage.setItem(KEY, JSON.stringify({ theme: theme, until: Date.now() + 365 * 24 * 3600 * 1000 })); } catch (e) {}
      return apply();
    },
    clear: function () { try { localStorage.removeItem(KEY); } catch (e) {} return apply(); }
  };
  apply();
})();
</script>

<link rel="preload" href="/fonts/be-vietnam-pro-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/be-vietnam-pro-vietnamese-400-normal.woff2" as="font" type="font/woff2" crossorigin />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:locale" content="vi_VN" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
