---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, topicBySlug } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { minutes?: number };

const { title, description, pubDate, updatedDate, heroImage, minutes } = Astro.props;
const topic = topicBySlug(Astro.props.topic);
---

<!doctype html>
<html lang="vi">
  <head>
    <BaseHead title={`${title} | ${SITE_TITLE}`} description={description} image={heroImage} />
  </head>
  <body>
    <div class="progress" id="readProgress" aria-hidden="true"></div>
    <Header />
    <main id="noi-dung">
      <article>
        <header class="narrow article-head">
          <div class="meta">
            {topic && <a class="tag" href={`/chu-de/${topic.slug}/`}>{topic.name}</a>}
            <FormattedDate date={pubDate} />
            {minutes && <span>{minutes} phút đọc</span>}
          </div>
          <h1>{title}</h1>
          <p class="lead">{description}</p>
          {updatedDate && <p class="meta">Cập nhật lần cuối: <FormattedDate date={updatedDate} /></p>}
        </header>
        {heroImage && (
          <div class="narrow article-hero">
            <img width={1020} height={510} src={heroImage} alt="" />
          </div>
        )}
        <div class="narrow prose">
          <slot />
        </div>
        <footer class="narrow article-foot">
          <a class="more" href="/blog">&larr; Tất cả bài viết</a>
        </footer>
      </article>
    </main>
    <Footer />
    <script is:inline>
    (function () {
      var bar = document.getElementById('readProgress');
      if (!bar) return;
      function update() {
        var el = document.documentElement;
        var max = el.scrollHeight - el.clientHeight;
        bar.style.width = (max > 0 ? Math.min(100, (el.scrollTop / max) * 100) : 0) + '%';
      }
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
    </script>
  </body>
</html>
