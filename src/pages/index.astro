---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostItem from '../components/PostItem.astro';
import { SITE_TITLE, SITE_DESCRIPTION, TOPICS, readingMinutes, topicBySlug } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = posts[0];
const latest = posts.slice(1, 4);
const featuredTopic = featured ? topicBySlug(featured.data.topic) : undefined;
---

<!doctype html>
<html lang="vi">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main id="noi-dung">
      <section class="hero">
        <div class="wrap hero-grid">
          <div>
            <p class="eyebrow" id="greeting">Xin chào</p>
            <h1>Ghi chép về <em>quản trị</em>, kỹ thuật và công nghệ.</h1>
            <p class="lead">Đây là nơi tôi viết lại những điều học được trong công việc và cuộc sống: ngắn gọn, thẳng thắn, dùng được ngay.</p>
            <div class="cta">
              <a class="btn btn-solid" href={featured ? `/blog/${featured.id}/` : '/blog'}>Đọc bài mới nhất <span aria-hidden="true">&rarr;</span></a>
              <a class="btn btn-line" href="/about">Về tôi</a>
            </div>
          </div>
          <div class="scene" aria-hidden="true">
            <svg viewBox="0 0 500 400" preserveAspectRatio="xMidYMid slice">
              <rect class="sky" width="500" height="400"></rect>
              <circle class="star" cx="70" cy="60" r="3"></circle><circle class="star" cx="150" cy="120" r="2"></circle>
              <circle class="star" cx="300" cy="50" r="2.5"></circle><circle class="star" cx="420" cy="90" r="3"></circle>
              <circle class="star" cx="380" cy="170" r="2"></circle><circle class="star" cx="250" cy="150" r="2"></circle>
              <circle class="star" cx="455" cy="200" r="2.5"></circle><circle class="star" cx="40" cy="170" r="2"></circle>
              <g class="orb"><circle cx="365" cy="110" r="52"></circle><circle class="bite" cx="390" cy="92" r="46"></circle></g>
              <path class="h3" d="M0 290 L120 190 L230 270 L330 200 L500 300 V400 H0Z"></path>
              <path class="h2" d="M0 330 L90 260 L210 320 L340 250 L500 340 V400 H0Z"></path>
              <path class="h1" d="M0 370 L140 310 L280 360 L400 315 L500 365 V400 H0Z"></path>
            </svg>
          </div>
        </div>
      </section>

      {featured && (
        <section class="section" aria-labelledby="h-noi-bat">
          <div class="wrap">
            <div class="sec-head"><h2 id="h-noi-bat">Bài nổi bật</h2></div>
            <article class="feature">
              <a class="feature-art" href={`/blog/${featured.id}/`} tabindex="-1" aria-hidden="true"><span class="a"></span><span class="b"></span><span class="c"></span></a>
              <div class="feature-body">
                <div class="meta">
                  {featuredTopic && <a class="tag" href={`/chu-de/${featuredTopic.slug}/`}>{featuredTopic.name}</a>}
                  <FormattedDate date={featured.data.pubDate} />
                  <span>{readingMinutes(featured.body)} phút đọc</span>
                </div>
                <h3><a href={`/blog/${featured.id}/`}>{featured.data.title}</a></h3>
                <p class="excerpt">{featured.data.description}</p>
                <a class="read" href={`/blog/${featured.id}/`}>Đọc tiếp <span aria-hidden="true">&rarr;</span></a>
              </div>
            </article>
          </div>
        </section>
      )}

      <section class="section" id="bai-viet" aria-labelledby="h-moi">
        <div class="wrap">
          <div class="sec-head"><h2 id="h-moi">Bài mới</h2><a class="more" href="/blog">Tất cả bài viết &rarr;</a></div>
          <div class="posts">
            {latest.map((post) => <PostItem post={post} />)}
            {posts.length === 0 && <p class="empty">Chưa có bài viết nào.</p>}
          </div>
        </div>
      </section>

      <section class="section" id="chu-de" aria-labelledby="h-chu-de">
        <div class="wrap">
          <div class="sec-head"><h2 id="h-chu-de">Chủ đề</h2></div>
          <div class="topics">
            {TOPICS.map((t) => (
              <a class="topic" href={`/chu-de/${t.slug}/`}>
                <svg class="topic-ico" viewBox="0 0 36 36" fill="currentColor" aria-hidden="true" set:html={t.icon}></svg>
                <div><h3>{t.name}</h3><p>{t.desc}</p></div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="gioi-thieu" aria-labelledby="h-gioi-thieu">
        <div class="wrap about">
          <div class="avatar" aria-hidden="true">VH</div>
          <div>
            <h2 id="h-gioi-thieu">Xin chào, tôi là {SITE_TITLE}</h2>
            <p>Blog này là nơi tôi ghi lại những điều học được trong công việc và cuộc sống, để dùng lại và để chia sẻ.</p>
            <div class="cta">
              <a class="btn btn-line" href="/about">Đọc thêm về tôi</a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
