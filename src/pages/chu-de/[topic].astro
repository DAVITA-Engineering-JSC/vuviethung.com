---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostItem from '../../components/PostItem.astro';
import { SITE_TITLE, TOPICS } from '../../consts';

export function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { topic: t.slug }, props: { topic: t } }));
}

const { topic } = Astro.props;
const posts = (await getCollection('blog'))
  .filter((p) => p.data.topic === topic.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="vi">
  <head>
    <BaseHead title={`${topic.name} | ${SITE_TITLE}`} description={topic.desc} />
  </head>
  <body>
    <Header />
    <main id="noi-dung">
      <div class="wrap page-head">
        <p class="eyebrow">Chủ đề</p>
        <h1>{topic.name}</h1>
        <p class="lead">{topic.desc}</p>
      </div>
      <div class="wrap page-body">
        <div class="posts">
          {posts.map((post) => <PostItem post={post} />)}
          {posts.length === 0 && <p class="empty">Chưa có bài viết nào trong chủ đề này. <a class="more" href="/blog">Xem tất cả bài viết &rarr;</a></p>}
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
